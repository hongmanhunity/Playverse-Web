MONGO_URI=mongodb://127.0.0.1:27017/playverse
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# JWT Configuration (Dual-Token Standard)
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRE=7d

# Email OTP Configuration (Cho chọn 1 trong 2 cách khi deploy VPS)
# Cách 1: Resend HTTP API (Khuyên dùng trên VPS vì đi qua cổng 443, không bị chặn port SMTP)
RESEND_API_KEY=
EMAIL_FROM=PlayVerse <no-reply@yourdomain.com>

# Cách 2: Nodemailer SMTP (Gmail App Password / Brevo / Mailgun)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional Google OAuth
GOOGLE_CLIENT_ID=
