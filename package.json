{
  "name": "playverse",
  "version": "1.0.0",
  "private": true,
  "description": "PlayVerse Full-Stack Monorepo (Express + MongoDB Backend & React + Ant Design Frontend)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c cyan,magenta \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "start": "npm --prefix server run start",
    "build": "npm --prefix client run build",
    "client:build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "install:all": "npm install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.3"
  }
}
